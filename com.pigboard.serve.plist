<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pigboard.serve</string>

  <!-- 常驻看板服务，供本机与 iPhone 访问 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/serve_daemon.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__ROOT__/logs/serve.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/serve.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
